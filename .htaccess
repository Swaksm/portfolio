# swaks.org — configuration Apache (hébergement OVH mutualisé)

# Page d'erreur personnalisée
ErrorDocument 404 /404.html

# Une seule adresse : https://swaks.org (sans www, en HTTPS)
# Méthode recommandée par OVH (test du port 80). En cas de boucle de redirection,
# commenter ces 4 lignes.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{SERVER_PORT} 80 [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://swaks.org/$1 [R=301,L]
</IfModule>

# Sources du build (script, contenus) : pas servies en ligne
RedirectMatch 404 ^/_build(/|$)

# Types de fichiers
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache navigateur (le HTML est toujours revérifié pour voir les mises à jour)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# En-têtes de sécurité simples
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
