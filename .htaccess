# swaks.org — configuration Apache (hébergement OVH mutualisé)

# Page d'erreur personnalisée
ErrorDocument 404 /404.html

# Pas de liste des fichiers d'un dossier (/projects/, /img/…) ni de page servie sans
# son extension (/about pour /about.html) : Google les voyait comme pages en double
Options -Indexes -MultiViews

# Une seule adresse : https://swaks.org (sans www, en HTTPS)
# Méthode recommandée par OVH (test du port 80). En cas de boucle de redirection,
# commenter ces 4 lignes.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{SERVER_PORT} 80 [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://swaks.org/$1 [R=301,L]

  # /index.html et /fr/index.html : une seule adresse, celle du dossier (/ et /fr/)
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?]
  RewriteRule ^(.*/)?index\.html$ https://swaks.org/$1 [R=301,L]

  # Dossier sans « / » final (/fr, /kleaner) : redirigé ici, sinon Apache ajoute « :443 » à l'adresse
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://swaks.org/$1/ [R=301,L]
</IfModule>

# Sources du build (script, contenus) : pas servies en ligne
RedirectMatch 404 ^/_build(/|$)
# État du déploiement automatique (liste des fichiers envoyés) : pas servi non plus
RedirectMatch 404 ^/\.ftp-deploy-sync-state\.json$

# Types de fichiers
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache navigateur (le HTML est toujours revérifié pour voir les mises à jour)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  # CSS et JS : adresse versionnée par le build (?v=…), donc gardés 1 an sans risque de vieille version
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# En-têtes de sécurité simples
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HTTPS imposé par le navigateur pendant 1 an (sous-domaines non inclus)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Sources autorisées : le site, Umami (stats), API GitHub (stats projets), Formspree (formulaire).
  # Scripts écrits dans les pages : autorisés un par un par leur empreinte sha256, que _build/build.py
  # recalcule. Après toute modification d'un de ces scripts, relancer le build, sinon le navigateur le bloque.
  # shortcut: 'unsafe-inline' reste pour les styles (attributs style="--i:…") ; passer à des classes pour durcir.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-C5JiiLH5+BT0c5v8ZsjXlqr7fUqJDY6GMGCP0w6RN4I=' 'sha256-GpDAa2vyIuLgmGZFXTcgIIIkJ3kYUDg0jwpIQ00qiXw=' 'sha256-NbbQqsyztcAAf0ywgdbavVczdwQyPsS5OpN5yucbw+Y=' 'sha256-XN777FnpxDb06zN+SyqhVLdY+PZD71L0NFS3wrVgkEs=' 'sha256-j+ttDnTfb2UknelireklVbQiG/CEQ8pnc78vTqvzjdo=' 'sha256-lkSj3GWqc0XQSXJLNrkkheCQEfybTXLP6SGl5OSTZqo=' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com https://formspree.io https://gateway.umami.is; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
</IfModule>
