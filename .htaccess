# swaks.org — configuration Apache (hébergement OVH mutualisé)

# Page d'erreur personnalisée
ErrorDocument 404 /404.html

# Une seule adresse : https://swaks.org (sans www, en HTTPS)
# Méthode recommandée par OVH (test du port 80). En cas de boucle de redirection,
# commenter ces 4 lignes.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{SERVER_PORT} 80 [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://swaks.org/$1 [R=301,L]
</IfModule>

# Sources du build (script, contenus) : pas servies en ligne
RedirectMatch 404 ^/_build(/|$)
# État du déploiement automatique (liste des fichiers envoyés) : pas servi non plus
RedirectMatch 404 ^/\.ftp-deploy-sync-state\.json$

# Types de fichiers
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache navigateur (le HTML est toujours revérifié pour voir les mises à jour)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# En-têtes de sécurité simples
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HTTPS imposé par le navigateur pendant 1 an (sous-domaines non inclus)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Sources autorisées : le site, Umami (stats), API GitHub (stats projets), Formspree (formulaire).
  # shortcut: 'unsafe-inline' car scripts et styles sont écrits dans les pages ; passer à des hashes calculés par build.py pour durcir.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com https://formspree.io https://gateway.umami.is; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
</IfModule>
